{
  "version": 8,
  "name": "base-neutral-with-borders",

  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=D9xNoMhtxFhgTxFI2GFx",

  "sources": {
    "omt": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key=D9xNoMhtxFhgTxFI2GFx"
    }
  },

  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8fafc"
      }
    },

    {
      "id": "admin-country-borders",
      "type": "line",
      "source": "omt",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#64748b",
        "line-width": 1.4,
        "line-opacity": 0.9
      }
    },

    {
      "id": "admin-region-borders",
      "type": "line",
      "source": "omt",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#cbd5e1",
        "line-width": 0.8,
        "line-dasharray": [2, 2],
        "line-opacity": 0.8
      }
    }
  ]
}